<Window x:Class="PDFMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PDFMaster.Views"
        Title="PDFMaster"
        Icon="Assets/app.ico"
        Height="900" Width="1180"
        MinHeight="680" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Grid x:Name="RootLayoutGrid" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/app-icon.png" Width="40" Height="40" Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="PDFMaster" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="SubtitleText" Text="Modern PDF editor, compressor, and merge tool"
                               FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="LanguageCombo" Width="130" Margin="0,0,10,0" SelectionChanged="LanguageCombo_SelectionChanged" />
                <Button x:Name="ThemeButton" Content="Theme" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="ThemeButton_Click" />
                <Button x:Name="AboutButton" Content="About" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="AboutButton_Click" />
                <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource SecondaryButton}" Click="SettingsButton_Click" />
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem x:Name="EditorTab" Header="Edit PDF">
                <views:PdfEditorView x:Name="EditorPanel" />
            </TabItem>
            <TabItem x:Name="CompressTab" Header="Compress">
                <views:PdfCompressView x:Name="CompressPanel" />
            </TabItem>
            <TabItem x:Name="MergeTab" Header="Merge PDF">
                <views:PdfMergeView x:Name="MergePanel" />
            </TabItem>
            <TabItem x:Name="ToolsTab" Header="Tools">
                <views:PdfToolsView x:Name="ToolsPanel" />
            </TabItem>
            <TabItem x:Name="PdfToWordTab" Header="PDF to Word">
                <views:PdfToWordView x:Name="PdfToWordPanel" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,10"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="16,0,0,0">
                    <Run Text="© 2026 " />
                    <Hyperlink NavigateUri="https://github.com/mothannakhzaleh" RequestNavigate="CopyrightLink_RequestNavigate">mothannakh</Hyperlink>
                    <Run Text=" · " />
                    <Hyperlink NavigateUri="https://satisfy.live/" RequestNavigate="CopyrightLink_RequestNavigate">satisfy.live</Hyperlink>
                    <Run Text=" · " />
                    <Hyperlink NavigateUri="https://www.youtube.com/@ToPSourceDevelopment" RequestNavigate="CopyrightLink_RequestNavigate">YouTube</Hyperlink>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
