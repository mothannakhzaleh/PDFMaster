<Window x:Class="PDFMaster.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Icon="Assets/app.ico"
        Height="440" Width="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="/Assets/app-icon.png" Width="56" Height="56" Margin="0,0,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="PDFMaster" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="VersionText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="DescriptionText" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="FeaturesText" Grid.Row="1" Margin="0,20,0,0" TextWrapping="Wrap" LineHeight="22"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <TextBlock x:Name="AuthorText" Grid.Row="2" Margin="0,16,0,0" FontSize="13"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap">
            <Run x:Name="AuthorPrefixRun" Text="Copyright © 2026 " />
            <Hyperlink NavigateUri="https://github.com/mothannakhzaleh" RequestNavigate="Link_RequestNavigate">mothannakh</Hyperlink>
            <Run Text=" · " />
            <Hyperlink NavigateUri="https://satisfy.live/" RequestNavigate="Link_RequestNavigate">https://satisfy.live/</Hyperlink>
        </TextBlock>

        <Button x:Name="CloseButton" Grid.Row="3" Content="Close" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" Margin="0,20,0,0" Click="CloseButton_Click" />
    </Grid>
</Window>
