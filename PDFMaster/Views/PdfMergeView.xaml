<UserControl x:Class="PDFMaster.Views.PdfMergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,8,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="240" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <Button x:Name="AddFilesButton" Content="Add PDFs" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="AddFilesButton_Click" />
                <Button x:Name="RemoveButton" Content="Remove" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="RemoveButton_Click" />
                <Button x:Name="MoveUpButton" Content="Move up" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="MoveUpButton_Click" />
                <Button x:Name="MoveDownButton" Content="Move down" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="MoveDownButton_Click" />
                <Button x:Name="ClearButton" Content="Clear list" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="ClearButton_Click" />
            </WrapPanel>

            <ListBox x:Name="FilesList" Grid.Row="2" DisplayMemberPath="DisplayText"
                     SelectionChanged="FilesList_SelectionChanged" Margin="0,0,0,12" />

            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="OutputNameLabel" Text="Output file name" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="OutputNameBox" Text="merged.pdf" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="OutputFolderLabel" Text="Output folder" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputFolderBox" />
                        <Button x:Name="BrowseOutputButton" Grid.Column="1" Content="..." Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButton}" Padding="12,10" Click="BrowseOutputButton_Click" />
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4">
                <Button x:Name="MergeButton" Content="Merge PDFs" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Click="MergeButton_Click" />
                <TextBlock x:Name="ResultText" Margin="0,16,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
